# Supabase Configuration (Legacy Vite - for reference)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Next.js Supabase Configuration (REQUIRED)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Application URL (REQUIRED for OAuth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (REQUIRED for Google Calendar integration)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Supabase Service Role Key (REQUIRED for OAuth callbacks - bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe Payment Processing (REQUIRED for payments)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Twilio Phone Integration (OPTIONAL - for phone call voice agent)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Edge Function Secrets (Add these in Supabase Dashboard → Edge Functions → Secrets)
# OPENAI_API_KEY=your_openai_api_key
# RESEND_API_KEY=your_resend_api_key
